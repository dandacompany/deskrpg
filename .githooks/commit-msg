#!/usr/bin/env bash
# Keep development metadata (session trailers, private board identifiers, private doc paths) out of commit messages.
# The rules live in one place: scripts/check-commit-meta.sh. One-off bypass: git commit --no-verify
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
bash "$repo/scripts/check-commit-meta.sh" < "$1"
