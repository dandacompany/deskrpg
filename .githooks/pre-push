#!/usr/bin/env bash
# Light pre-push gate — format:check · typecheck · lint (about 30s).
#
# Enable:  git config core.hooksPath .githooks   (once per clone/worktree)
# Disable: git push --no-verify                  (one-off bypass)
#
# Tests and build are **deliberately left out.** Together they take 4–5 minutes; charging that on every push
# makes bypassing routine, which is the same as having no hook. These three catch most of what CI catches
# and finish within 30 seconds. CI handles the rest.
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"

# Deleting pushes have nothing to check.
zero="0000000000000000000000000000000000000000"
only_deletes=1
ranges=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  only_deletes=0
  # For a new branch, look only at commits not on any remote; otherwise only commits after the remote head.
  if [ "$remote_sha" = "$zero" ]; then ranges+=("$local_sha --not --remotes")
  else ranges+=("$remote_sha..$local_sha"); fi
done
[ "$only_deletes" -eq 1 ] && exit 0

# Development metadata in commit messages — runs before the 30s gate and takes milliseconds.
# rebase, cherry-pick and merge do not rerun the commit-msg hook, so this is the last gate before publishing.
meta_failed=0
meta_err="$(mktemp)"
for range in "${ranges[@]}"; do
  # shellcheck disable=SC2086
  for sha in $(git rev-list $range); do
    if ! git log -1 --format=%B "$sha" | bash "$repo/scripts/check-commit-meta.sh" 2>"$meta_err"; then
      printf '\n\033[1;31m[pre-push] %s %s\033[0m\n' "$(git log -1 --format=%h "$sha")" "$(git log -1 --format=%s "$sha")" >&2
      cat "$meta_err" >&2
      meta_failed=1
    fi
  done
done
rm -f "$meta_err"
if [ "$meta_failed" -ne 0 ]; then
  printf '\n\033[1;31m[pre-push] 공개 레포에 개발 메타가 든 커밋을 올리려 한다. 메시지를 고친 뒤(git rebase -i 의 reword) 다시 푸시하라.\033[0m\n' >&2
  exit 1
fi

if [ ! -d "$repo/node_modules" ]; then
  printf '\n\033[1;33m[pre-push] node_modules 가 없어 건너뛴다. `npm ci` 후 다시 푸시하면 검사한다.\033[0m\n'
  exit 0
fi

cd "$repo"
printf '\n\033[1m[pre-push] format:check · typecheck · lint (약 30초). 건너뛰려면 --no-verify.\033[0m\n'

# Capture the log with mktemp. A fixed name under /tmp lets someone plant a symlink beforehand
# and make us overwrite the wrong file (a real risk on shared machines).
log="$(mktemp -t deskrpg-prepush)"
trap 'rm -f "$log"' EXIT

# If DATABASE_URL is in the shell, tests and tools grab that DB — strip it as the repo convention says.
for step in format:check typecheck lint; do
  printf '  → %s\n' "$step"
  if ! env -u DATABASE_URL npm run -s "$step" >"$log" 2>&1; then
    printf '\n\033[1;31m[pre-push] %s 실패 — 푸시를 막는다.\033[0m\n' "$step"
    tail -30 "$log"
    printf '\n고치고 다시 푸시하거나, 의도적이면 `git push --no-verify`.\n\n'
    exit 1
  fi
done
printf '\033[1;32m[pre-push] 통과 — 푸시한다.\033[0m\n'
