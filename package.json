{
  "name": "deskrpg",
  "version": "2026.926.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dandacompany/deskrpg.git"
  },
  "homepage": "https://deskrpg.com",
  "bugs": {
    "url": "https://github.com/dandacompany/deskrpg/issues"
  },
  "private": false,
  "bin": {
    "deskrpg": "bin/deskrpg.js"
  },
  "files": [
    "bin",
    "server.js",
    "public",
    "src/db",
    "src/lib",
    "src/server",
    "src/game/navigation.ts",
    "src/game/three",
    "src/game/ambient-zones.ts",
    "src/game/meeting-map-normalization.ts",
    "src/game/meeting-space.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!.next/**/*.map",
    "!.next/standalone/playwright*.config.*",
    "!.next/standalone/tsconfig.tsbuildinfo",
    "!.next/standalone/src/test-setup/**",
    "drizzle",
    ".env.example",
    "drizzle-sqlite.config.ts",
    "next.config.ts",
    ".next/BUILD_ID",
    ".next/app-path-routes-manifest.json",
    ".next/build-manifest.json",
    ".next/prerender-manifest.json",
    ".next/required-server-files.json",
    ".next/routes-manifest.json",
    ".next/standalone/**/*",
    ".next/server/**/*",
    ".next/static/**/*"
  ],
  "scripts": {
    "dev": "npx tsx dev-server.ts",
    "dev:debug": "DEBUG_CHAT=1 npx tsx dev-server.ts",
    "dev:next": "next dev",
    "setup": "docker compose up -d deskrpg-db && dotenv -e .env.local -- drizzle-kit migrate && echo '✓ Ready — run: npm run dev'",
    "setup:lite": "node scripts/setup/setup-lite.js",
    "build": "next build",
    "pack:npm": "mkdir -p .artifacts/npm .artifacts/.npm-cache && npm_config_cache=.artifacts/.npm-cache npm pack --pack-destination .artifacts/npm",
    "start": "node server.js",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"src/**/*.test.js\" \"src/**/[[]*[]]/**/*.test.ts\" \"src/**/[[]*[]]/**/*.test.tsx\" \"src/**/[[]*[]]/**/*.test.js\" \"tools/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "runtime:doctor": "node bin/deskrpg.js doctor",
    "tc": "bash scripts/tc",
    "prepack": "npm run build",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:setup": "dotenv -e .env.local -- drizzle-kit migrate",
    "deploy:test": "bash deploy/test-deploy.sh",
    "test:windows": "tsx --test src/lib/hermes/setup/windows-runtime.test.ts src/lib/windows-daemon.test.js src/lib/hermes/setup/ssh-keyscan-fallback.test.ts src/lib/hermes/setup/ssh-hosts.test.ts src/lib/hermes/setup/executor.test.ts src/lib/hermes/setup/platform.test.ts src/lib/hermes/setup/host-launcher.test.ts src/lib/hermes/setup/ssh-args.test.ts src/lib/hermes/setup/system-ssh.test.ts src/lib/child-process-casts.test.ts src/lib/startup-check.server-state.test.js src/lib/adapters/subprocess-pool.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:fixtures": "playwright test --config playwright.fixtures.config.ts",
    "capture:readme": "tsx scripts/readme-capture/session.ts",
    "capture:readme:record": "playwright test --config playwright.readme-capture.config.ts",
    "capture:readme:media": "tsx scripts/readme-capture/media.ts",
    "capture:readme:verify": "tsx scripts/readme-capture/verify-readme.ts"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.8.0",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.15",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.15",
    "tsx": "^4.21.0",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/three": "^0.180.0",
    "canvas": "^3.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
